# Copia este archivo a .env y rellena los valores. NO subas .env a git.
# Su utilidad: documenta qué variables necesita la app (el .env real no se versiona).

# --- OpenAI (LLM + embeddings) ---
OPENAI_API_KEY=
# Endpoint de OpenAI. Vacío = endpoint por defecto (EE. UU.), que es donde corre el prototipo.
# Esta variable la leen TODAS las llamadas del proyecto (generación, embeddings, validador,
# assess, la extracción de LightRAG y los scripts de ingesta), así que cambiar de región es
# cambiar esta línea.
# PENDIENTE (ver CLAUDE.md): pasar a residencia europea. OJO: OpenAI configura la residencia
# POR PROYECTO y SOLO AL CREARLO —un proyecto existente no se puede migrar—, así que hace falta
# crear un proyecto nuevo con región Europa y usar SU api key junto con este endpoint.
#   UE: https://eu.api.openai.com/v1
OPENAI_BASE_URL=

# --- Qdrant Cloud (vector store) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- LangSmith (trazado/auditoría del grafo) ---
# Consigue la API key en https://smith.langchain.com (Settings > API Keys).
# Si dejas LANGSMITH_API_KEY vacía, el grafo funciona igual pero sin enviar trazas.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot-vih
# Endpoint regional: US (por defecto) o UE si tu cuenta de LangSmith es europea.
#   US: https://api.smith.langchain.com   |   UE: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
