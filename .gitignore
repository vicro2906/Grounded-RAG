# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env
# Logs
*.log

# LangGraph dev server (caché local)
.langgraph_api/

# Generated graph indexes — rebuilt from the corpus, never committed:
#   python -m retrieval.graph     (LightRAG store; PathRAG reads it too)
#   python -m retrieval.hipporag  (HippoRAG 2 store)
data/lightrag_store/
data/hipporag_store/
_probe_store/

# PDFs originales de GeSIDA: se conservan en local pero NO se redistribuyen (© GeSIDA)
data/pdfs/

# Chainlit: config.toml and chainlit.md ARE ours and are committed; the rest is regenerated
# boilerplate (24 UI translation files) and per-session state.
.chainlit/translations/
.files/
# Chainlit regenerates a DEFAULT config next to the app when launched from elsewhere. Ours is
# the one at the repo root (run `chainlit run web/app.py` from there); this duplicate would
# silently shadow it.
web/.chainlit/
